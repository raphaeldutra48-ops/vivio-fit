# Copie para apps/api/.env e preencha. O .env real NUNCA entra no git.

# --- Banco ---
# Neon: postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- API ---
PORT=3333
NODE_ENV=development

# --- Auth (gerar com: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Preenchidos em fases posteriores ---
# REDIS_URL=              # C8 — lembretes/BullMQ
# S3_ENDPOINT=            # C7 — video e fotos
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FCM_SERVICE_ACCOUNT=    # C8 — push
