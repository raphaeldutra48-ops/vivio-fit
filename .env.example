# Copie para apps/api/.env e preencha. O .env real NUNCA entra no git.

# --- Banco (Neon) ---
# O Neon entrega DUAS strings e o Prisma precisa das duas:
#   DATABASE_URL -> conexão POOLED (host com "-pooler"), usada pela aplicação
#   DIRECT_URL   -> conexão DIRETA (sem "-pooler"), exigida por `prisma migrate`
# Migração pela URL pooled falha de forma confusa — não misturar.
DATABASE_URL=
DIRECT_URL=

# --- API ---
PORT=3333
NODE_ENV=development

# --- Auth (gerar com: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Preenchidos em fases posteriores ---
# REDIS_URL=              # C8 — lembretes/BullMQ
# S3_ENDPOINT=            # C7 — video e fotos
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FCM_SERVICE_ACCOUNT=    # C8 — push
