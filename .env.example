# Copie para apps/api/.env e preencha. O .env real NUNCA entra no git.

# --- Banco (Neon) ---
# O Neon entrega DUAS strings e o Prisma precisa das duas:
#   DATABASE_URL -> conexão POOLED (host com "-pooler"), usada pela aplicação
#   DIRECT_URL   -> conexão DIRETA (sem "-pooler"), exigida por `prisma migrate`
# Migração pela URL pooled falha de forma confusa — não misturar.
DATABASE_URL=
DIRECT_URL=

# --- API ---
PORT=3333
NODE_ENV=development

# --- Auth (gerar com: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Mídia (fotos de evolução e vídeos) ---
# Sem as quatro abaixo, a mídia grava no disco do contêiner — e o disco é
# apagado a cada deploy. Em desenvolvimento isso é o certo; em produção
# significa perder as fotos de antes e depois dos alunos.
# O bucket é PRIVADO: a entrega é sempre por URL assinada de curta duração.
# Cloudflare R2: 10 GB grátis e sem cobrança de egresso, que é o que pesa
# quando o app serve imagem toda vez que alguém abre a evolução.
# MEDIA_DIR=./media       # usado só no modo disco
# R2_BUCKET=
# R2_ACCOUNT_ID=          # o hex do painel do R2; ou informe R2_ENDPOINT
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=            # opcional: substitui R2_ACCOUNT_ID se usar domínio próprio

# --- Preenchidos em fases posteriores ---
# REDIS_URL=              # C8 — lembretes/BullMQ
# FCM_SERVICE_ACCOUNT=    # C8 — push
