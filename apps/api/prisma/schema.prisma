// Schema do Vívio Fit.
// Os modelos de domínio entram no passo B1 (identidade e vínculo).
// Regra: entidade clínica nunca é deletada fisicamente — usar `deletadoEm`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
