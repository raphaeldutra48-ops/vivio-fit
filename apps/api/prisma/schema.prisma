// Schema do Vívio Fit.
//
// Convenções:
//  - id sempre cuid()
//  - toda tabela tem criadoEm / atualizadoEm
//  - entidade clínica NUNCA é deletada fisicamente (usar deletadoEm)
//  - nomes de domínio em português, termos técnicos em inglês
//
// Blocos já modelados: 4.1 identidade e vínculo · 4.2 LGPD (consentimento e auditoria)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão pooled — usada pela aplicação
  directUrl = env("DIRECT_URL") // conexão direta — exigida por prisma migrate
}

// ---------------------------------------------------------------------------
// 4.1 — Identidade e vínculo
// ---------------------------------------------------------------------------

enum Papel {
  ALUNO
  PERSONAL
  NUTRICIONISTA
  MEDICO
  ADMIN
  ACADEMIA
}

enum StatusConta {
  PENDENTE_VERIFICACAO
  ATIVA
  SUSPENSA
  DESATIVADA
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  senhaHash     String? // null quando a conta usa apenas login social
  nome          String
  telefone      String?
  avatarUrl     String?
  papel         Papel
  status        StatusConta @default(PENDENTE_VERIFICACAO)
  emailVerifEm  DateTime?
  ultimoLoginEm DateTime?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  deletadoEm    DateTime?

  perfilAluno        PerfilAluno?
  perfilProfissional PerfilProfissional?
  sessoes            SessaoRefresh[]
  tokensDeVerificacao TokenVerificacaoEmail[]
  profissionaisVerificados PerfilProfissional[] @relation("ProfissionaisVerificados")

  receitas           Receita[]        @relation("ReceitasDoAutor")
  refeicoesSalvas    RefeicaoSalva[]  @relation("RefeicoesDoAutor")
  modelosDeAnamnese  ModeloAnamnese[] @relation("ModelosDeAnamnese")
  anamnesesComoAluno Anamnese[]       @relation("AnamnesesDoAluno")
  anamnesesAplicadas Anamnese[]       @relation("AnamnesesAplicadas")

  // Vínculos: um mesmo User aparece de um lado ou do outro conforme o papel
  vinculosComoAluno        Vinculo[] @relation("VinculoAluno")
  vinculosComoProfissional Vinculo[] @relation("VinculoProfissional")

  consentimentosConcedidos Consentimento[] @relation("ConsentimentoAluno")
  consentimentosRecebidos  Consentimento[] @relation("ConsentimentoProfissional")

  acoesAuditadas      LogAuditoria[] @relation("AuditoriaAtor")
  acessosAosMeusDados LogAuditoria[] @relation("AuditoriaTitular")

  medidas           Medida[]      @relation("MedidasDoAluno")
  exerciciosCriados Exercicio[]   @relation("ExerciciosCriados")
  planosComoAluno   PlanoTreino[] @relation("PlanosDoAluno")
  planosComoPersonal PlanoTreino[] @relation("PlanosDoPersonal")
  execucoes          ExecucaoTreino[] @relation("ExecucoesDoAluno")
  fotosEvolucao      FotoEvolucao[]   @relation("FotosDoAluno")
  dispositivos       TokenDispositivo[]
  lembretes          ConfiguracaoLembrete[] @relation("LembretesDoAluno")
  notificacoes       Notificacao[]          @relation("NotificacoesDoUsuario")

  dietasComoAluno         PlanoDieta[]       @relation("DietasDoAluno")
  dietasComoNutricionista PlanoDieta[]       @relation("DietasDoNutricionista")
  modelosDeCardapio       ModeloCardapio[]   @relation("ModelosDoNutricionista")
  registrosDeRefeicao     RegistroRefeicao[] @relation("RegistrosDeRefeicao")
  metaDeAgua              MetaAgua?          @relation("MetaDeAgua")
  registrosDeAgua         RegistroAgua[]     @relation("RegistrosDeAgua")

  prescricoesComoAluno    Prescricao[]          @relation("PrescricoesDoAluno")
  prescricoesEmitidas     Prescricao[]          @relation("PrescricoesEmitidas")
  modelosDePrescricao     ModeloPrescricao[]    @relation("ModelosDePrescricao")
  itensPrescritiveis      ItemPrescritivel[]    @relation("ItensPrescritiveis")

  avaliacoesComoAluno     AvaliacaoFisica[]     @relation("AvaliacoesDoAluno")
  avaliacoesFeitas        AvaliacaoFisica[]     @relation("AvaliacoesFeitas")

  agendaComoProfissional  Compromisso[]         @relation("AgendaDoProfissional")
  compromissosComoAluno   Compromisso[]         @relation("CompromissosDoAluno")
  disponibilidade         DisponibilidadeSlot[] @relation("DisponibilidadeDoProfissional")
  bloqueiosDeAgenda       BloqueioAgenda[]      @relation("BloqueiosDoProfissional")

  conversasComoAluno Conversa[]             @relation("ConversasDoAluno")
  participacoes      ParticipanteConversa[] @relation("ParticipacoesEmConversas")
  mensagensEnviadas  Mensagem[]             @relation("MensagensEnviadas")

  @@index([papel, status])
}

model PerfilAluno {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataNascimento DateTime
  sexoBiologico  String? // relevante para cálculo metabólico (TMB)
  alturaCm       Int?
  objetivo       String? // HIPERTROFIA | EMAGRECIMENTO | SAUDE | PERFORMANCE
  nivelAtividade String?
  timezone       String   @default("America/Sao_Paulo")
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

model PerfilProfissional {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo             Papel // PERSONAL | NUTRICIONISTA | MEDICO
  registroConselho String // CREF / CRN / CRM
  ufRegistro       String
  especialidades   String[]  @default([])
  bio              String?
  /// Preenchido pelo admin ao validar o registro no conselho.
  /// Sem isto, o profissional não pode receber vínculo.
  verificadoEm     DateTime?
  verificadoPorId  String?
  /// Quem aprovou fica registrado: liberar acesso a dado de saúde é ato de
  /// responsabilidade, e responsabilidade sem nome não existe.
  verificadoPor    User?     @relation("ProfissionaisVerificados", fields: [verificadoPorId], references: [id], onDelete: SetNull)
  /// Recusa é decisão registrada, não apagada: o profissional precisa saber
  /// por que, e uma recusa não some quando ele reenvia os dados.
  recusadoEm       DateTime?
  motivoRecusa     String?
  notaMedia        Decimal?  @db.Decimal(3, 2)
  totalAvaliacoes  Int       @default(0)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  @@unique([tipo, registroConselho, ufRegistro])
  @@index([verificadoEm, recusadoEm])
}

enum StatusVinculo {
  PENDENTE
  ATIVO
  ENCERRADO
  RECUSADO
}

/// Vínculo de cuidado: quem atende quem.
/// É a base de TODA autorização de acesso a dado de aluno.
model Vinculo {
  id             String        @id @default(cuid())
  alunoId        String
  aluno          User          @relation("VinculoAluno", fields: [alunoId], references: [id])
  profissionalId String
  profissional   User          @relation("VinculoProfissional", fields: [profissionalId], references: [id])
  /// Redundante com PerfilProfissional.tipo, mas evita join na checagem de
  /// "1 vínculo ativo por tipo" e no guard, que roda em toda requisição.
  tipo           Papel
  status         StatusVinculo @default(PENDENTE)
  convidadoPorId String
  iniciadoEm     DateTime?
  encerradoEm    DateTime?
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  @@unique([alunoId, profissionalId])
  @@index([profissionalId, status])
  @@index([alunoId, tipo, status])
}

// ---------------------------------------------------------------------------
// 4.2 — LGPD: consentimento e auditoria
// ---------------------------------------------------------------------------

enum EscopoDado {
  TREINO
  NUTRICAO
  CLINICO
  EVOLUCAO
  MENSAGENS
}

/// Consentimento explícito do aluno para compartilhar um escopo de dado.
/// Sem registro vigente aqui, o backend NEGA a leitura mesmo com vínculo ativo.
model Consentimento {
  id             String     @id @default(cuid())
  alunoId        String
  aluno          User       @relation("ConsentimentoAluno", fields: [alunoId], references: [id])
  escopo         EscopoDado
  /// null = consentimento vale para toda a equipe de cuidado do aluno
  profissionalId String?
  profissional   User?      @relation("ConsentimentoProfissional", fields: [profissionalId], references: [id])
  /// Texto exibido ao aluno no momento do aceite — prova de finalidade específica
  finalidade     String
  versaoTermo    String
  concedidoEm    DateTime   @default(now())
  revogadoEm     DateTime?
  ipOrigem       String?
  userAgent      String?

  @@index([alunoId, escopo, revogadoEm])
  @@index([profissionalId, revogadoEm])
}

enum AcaoAuditoria {
  LER
  CRIAR
  ATUALIZAR
  REMOVER
  EXPORTAR
  NEGADO
}

/// Trilha de auditoria. Toda leitura/escrita de dado clínico gera uma linha,
/// inclusive as NEGADAS — tentativa de acesso indevido é o que mais importa registrar.
///
/// ATENÇÃO: `metadata` nunca recebe conteúdo clínico. Só identificadores.
model LogAuditoria {
  id          String        @id @default(cuid())
  atorId      String
  ator        User          @relation("AuditoriaAtor", fields: [atorId], references: [id])
  acao        AcaoAuditoria
  recursoTipo String
  recursoId   String?
  /// Titular do dado. Alimenta a tela "quem viu meus dados" (direito LGPD).
  alunoId     String?
  aluno       User?         @relation("AuditoriaTitular", fields: [alunoId], references: [id])
  escopo      EscopoDado?
  ip          String?
  userAgent   String?
  metadata    Json?
  criadoEm    DateTime      @default(now())

  @@index([alunoId, criadoEm])
  @@index([atorId, criadoEm])
}

// ---------------------------------------------------------------------------
// 4.3 — Treino (biblioteca de exercícios e plano)
// ---------------------------------------------------------------------------

enum EscopoExercicio {
  GLOBAL
  PRIVADO
}

/// Biblioteca de exercícios. GLOBAL é curado pelo admin e visível a todos;
/// PRIVADO pertence ao profissional que criou.
model Exercicio {
  id            String          @id @default(cuid())
  nome          String
  grupoMuscular String
  equipamento   String?
  /// Chave no storage — a URL entregue ao cliente é sempre pré-assinada (C7).
  videoChave    String?
  thumbChave    String?
  instrucoes    String?
  escopo        EscopoExercicio @default(PRIVADO)
  criadoPorId   String?
  criadoPor     User?           @relation("ExerciciosCriados", fields: [criadoPorId], references: [id])
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt
  deletadoEm    DateTime?

  itens            ItemTreino[]
  seriesExecutadas SerieExecutada[]

  @@index([grupoMuscular])
  @@index([criadoPorId, escopo])
}

enum StatusPlano {
  RASCUNHO
  ATIVO
  ARQUIVADO
}

/// Plano de treino. Ajustar um plano cria uma VERSÃO NOVA em vez de sobrescrever:
/// o histórico precisa mostrar o que o aluno realmente executou em cada época.
model PlanoTreino {
  id         String      @id @default(cuid())
  alunoId    String
  aluno      User        @relation("PlanosDoAluno", fields: [alunoId], references: [id])
  personalId String
  personal   User        @relation("PlanosDoPersonal", fields: [personalId], references: [id])
  nome       String
  objetivo   String?
  versao     Int         @default(1)
  /// Agrupa todas as versões do mesmo plano. Null na versão 1 (ela é a raiz).
  raizId     String?
  status     StatusPlano @default(RASCUNHO)
  inicioEm   DateTime?
  fimEm      DateTime?
  criadoEm   DateTime    @default(now())
  atualizadoEm DateTime  @updatedAt

  sessoes SessaoTreino[]

  @@index([alunoId, status])
  @@index([raizId])
}

/// "Treino A", "Treino B"... dentro de um plano.
model SessaoTreino {
  id          String  @id @default(cuid())
  planoId     String
  plano       PlanoTreino @relation(fields: [planoId], references: [id], onDelete: Cascade)
  nome        String
  ordem       Int
  /// 1 = segunda ... 7 = domingo
  diaSugerido Int?

  itens     ItemTreino[]
  execucoes ExecucaoTreino[]

  @@unique([planoId, ordem])
}

model ItemTreino {
  id              String    @id @default(cuid())
  sessaoId        String
  sessao          SessaoTreino @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  exercicioId     String
  exercicio       Exercicio @relation(fields: [exercicioId], references: [id])
  ordem           Int
  series          Int
  /// Texto livre: "8-12", "até a falha", "30s". Não é sempre um número.
  repsAlvo        String
  cargaSugeridaKg Decimal?  @db.Decimal(6, 2)
  descansoSeg     Int?
  tecnica         String?
  observacao      String?
  /// Itens com o mesmo valor são executados em sequência (bi-set, tri-set).
  supersetGrupo   String?

  seriesExecutadas SerieExecutada[]

  @@unique([sessaoId, ordem])
  @@index([exercicioId])
}

/// Um treino realizado pelo aluno.
///
/// `clienteUuid` é gerado no celular ANTES de enviar. É o que torna o envio
/// idempotente: reenviar a mesma execução (rede caiu, app reabriu, fila de sync
/// repetiu) não cria uma segunda linha.
model ExecucaoTreino {
  id             String       @id @default(cuid())
  alunoId        String
  aluno          User         @relation("ExecucoesDoAluno", fields: [alunoId], references: [id])
  sessaoId       String
  sessao         SessaoTreino @relation(fields: [sessaoId], references: [id])
  clienteUuid    String       @unique
  iniciadoEm     DateTime
  finalizadoEm   DateTime?
  duracaoSeg     Int?
  origem         String       @default("APP")
  sincronizadoEm DateTime     @default(now())
  criadoEm       DateTime     @default(now())

  series   SerieExecutada[]
  feedback FeedbackTreino?

  @@index([alunoId, iniciadoEm(sort: Desc)])
  @@index([sessaoId])
}

enum TipoSerie {
  NORMAL
  AQUECIMENTO
  DROP
  FALHA
}

/// Append-only: série executada nunca é editada, só registrada.
/// É o dado que sustenta o "ANTERIOR" da tela de execução e o gráfico de carga.
model SerieExecutada {
  id           String         @id @default(cuid())
  execucaoId   String
  execucao     ExecucaoTreino @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  itemTreinoId String
  item         ItemTreino     @relation(fields: [itemTreinoId], references: [id])
  /// Desnormalizado de propósito. Cada versão do plano cria ItemTreino novos, então
  /// o histórico indexado por item se perderia a cada ajuste do personal. O exercício
  /// é o que permanece — é por ele que "anterior" e progressão de carga são buscados.
  exercicioId  String
  exercicio    Exercicio      @relation(fields: [exercicioId], references: [id])
  serieNum     Int
  repsFeitas   Int
  cargaKg      Decimal        @db.Decimal(6, 2)
  tipo         TipoSerie      @default(NORMAL)
  /// Escala de esforço percebido (1-10).
  rpe          Int?

  @@unique([execucaoId, itemTreinoId, serieNum])
  @@index([itemTreinoId])
  @@index([exercicioId])
}

/// Feedback pós-treino. Retroalimenta o personal e pode gerar alerta clínico
/// (dor repetida em execuções seguidas -> alerta para personal e médico).
model FeedbackTreino {
  id          String         @id @default(cuid())
  execucaoId  String         @unique
  execucao    ExecucaoTreino @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  /// 1 = muito fácil, 5 = muito difícil
  dificuldade Int
  teveDor     Boolean        @default(false)
  localDor    String?
  sensacao    String?
  comentario  String?
  criadoEm    DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// 4.5 — Evolução (parcial: medidas corporais)
// ---------------------------------------------------------------------------

enum FonteMedida {
  MANUAL
  BIOIMPEDANCIA
  WEARABLE
}

/// Peso e medidas ao longo do tempo. Escopo de consentimento: EVOLUCAO.
model Medida {
  id                String      @id @default(cuid())
  alunoId           String
  aluno             User        @relation("MedidasDoAluno", fields: [alunoId], references: [id])
  data              DateTime    @db.Date
  pesoKg            Decimal?    @db.Decimal(5, 2)
  percentualGordura Decimal?    @db.Decimal(4, 1)
  massaMagraKg      Decimal?    @db.Decimal(5, 2)
  cinturaCm         Decimal?    @db.Decimal(5, 1)
  quadrilCm         Decimal?    @db.Decimal(5, 1)
  bracoCm           Decimal?    @db.Decimal(5, 1)
  coxaCm            Decimal?    @db.Decimal(5, 1)
  toraxCm           Decimal?    @db.Decimal(5, 1)
  fonte             FonteMedida @default(MANUAL)
  registradoPorId   String
  criadoEm          DateTime    @default(now())
  atualizadoEm      DateTime    @updatedAt
  deletadoEm        DateTime?

  /// Uma medição por dia por aluno — remedir no mesmo dia atualiza a linha.
  @@unique([alunoId, data])
  @@index([alunoId, data(sort: Desc)])
}

enum AnguloFoto {
  FRENTE
  LADO
  COSTAS
  LIVRE
}

/// Foto de evolução. Escopo de consentimento: EVOLUCAO.
///
/// `chaveArquivo` é a chave no storage privado — NUNCA uma URL pública. A
/// entrega é sempre por link assinado de curta duração.
model FotoEvolucao {
  id           String     @id @default(cuid())
  alunoId      String
  aluno        User       @relation("FotosDoAluno", fields: [alunoId], references: [id])
  data         DateTime   @db.Date
  chaveArquivo String     @unique
  mimeType     String
  tamanhoBytes Int
  angulo       AnguloFoto @default(FRENTE)
  observacao   String?
  /// Papéis autorizados pelo aluno a ver esta foto. Vazio = só o próprio aluno.
  visivelPara  Papel[]    @default([])
  criadoEm     DateTime   @default(now())
  deletadoEm   DateTime?

  @@index([alunoId, data(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 4.4 — Nutrição
// ---------------------------------------------------------------------------

/// Tabela de composição de alimentos. Valores SEMPRE por 100 g, para o cálculo
/// da dieta ser uma regra de três simples e auditável.
model Alimento {
  id           String   @id @default(cuid())
  nome         String
  grupo        String
  kcal         Decimal  @db.Decimal(7, 2)
  proteinaG    Decimal  @db.Decimal(6, 2)
  carboidratoG Decimal  @db.Decimal(6, 2)
  gorduraG     Decimal  @db.Decimal(6, 2)
  fibraG       Decimal? @db.Decimal(6, 2)
  sodioMg      Decimal? @db.Decimal(7, 2)
  /// Medida caseira de referência, ex.: "1 filé médio (100 g)".
  medidaCaseira String?
  /// Gramas da medida caseira — o aluno pensa em "1 concha", não em gramas.
  medidaGramas  Decimal? @db.Decimal(6, 2)
  fonte        String   @default("TACO")
  criadoPorId  String?

  itens         ItemRefeicao[]
  itensDeModelo ItemModelo[]  @relation("ItensDeModelo")
  ingredientesDeReceita IngredienteReceita[] @relation("IngredientesDeReceita")
  itensDeRefeicaoSalva  ItemRefeicaoSalva[]  @relation("ItensDeRefeicaoSalva")

  @@index([nome])
  @@index([grupo])
}

/// Modelo de cardápio reutilizável, do nutricionista.
///
/// Mesma estrutura do PlanoDieta, mas sem aluno: é o molde. Aplicar num paciente
/// cria um PlanoDieta de verdade, que depois pode ser ajustado sem mexer no molde.
model ModeloCardapio {
  id              String   @id @default(cuid())
  nutricionistaId String
  nutricionista   User     @relation("ModelosDoNutricionista", fields: [nutricionistaId], references: [id], onDelete: Cascade)
  nome            String
  descricao       String?
  kcalAlvo        Int?
  proteinaAlvoG   Int?
  carboAlvoG      Int?
  gorduraAlvoG    Int?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  deletadoEm      DateTime?

  refeicoes RefeicaoModelo[]

  @@index([nutricionistaId, deletadoEm])
}

model RefeicaoModelo {
  id              String         @id @default(cuid())
  modeloId        String
  modelo          ModeloCardapio @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  nome            String
  horarioSugerido String?
  ordem           Int

  itens ItemModelo[]

  @@unique([modeloId, ordem])
}

model ItemModelo {
  id          String         @id @default(cuid())
  refeicaoId  String
  refeicao    RefeicaoModelo @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimentoId  String
  alimento    Alimento       @relation("ItensDeModelo", fields: [alimentoId], references: [id])
  quantidadeG Decimal        @db.Decimal(7, 2)
  observacao  String?
  ordem       Int

  @@unique([refeicaoId, ordem])
  @@index([alimentoId])
}

model PlanoDieta {
  id              String      @id @default(cuid())
  alunoId         String
  aluno           User        @relation("DietasDoAluno", fields: [alunoId], references: [id])
  nutricionistaId String
  nutricionista   User        @relation("DietasDoNutricionista", fields: [nutricionistaId], references: [id])
  nome            String
  observacao      String?
  /// Metas definidas pelo nutricionista. O total real vem da soma dos itens.
  kcalAlvo        Int?
  proteinaAlvoG   Int?
  carboAlvoG      Int?
  gorduraAlvoG    Int?
  versao          Int         @default(1)
  raizId          String?
  status          StatusPlano @default(RASCUNHO)
  inicioEm        DateTime?
  fimEm           DateTime?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  refeicoes Refeicao[]

  @@index([alunoId, status])
  @@index([raizId])
}

model Refeicao {
  id              String     @id @default(cuid())
  planoDietaId    String
  plano           PlanoDieta @relation(fields: [planoDietaId], references: [id], onDelete: Cascade)
  nome            String
  /// Horário sugerido, "HH:MM" no fuso do aluno.
  horarioSugerido String?
  ordem           Int

  itens     ItemRefeicao[]
  registros RegistroRefeicao[]

  @@unique([planoDietaId, ordem])
}

model ItemRefeicao {
  id          String   @id @default(cuid())
  refeicaoId  String
  refeicao    Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimentoId  String
  alimento    Alimento @relation(fields: [alimentoId], references: [id])
  quantidadeG Decimal  @db.Decimal(7, 2)
  observacao  String?
  ordem       Int

  @@unique([refeicaoId, ordem])
  @@index([alimentoId])
}

enum StatusRefeicao {
  FEITA
  PARCIAL
  PULADA
}

model RegistroRefeicao {
  id         String         @id @default(cuid())
  alunoId    String
  aluno      User           @relation("RegistrosDeRefeicao", fields: [alunoId], references: [id])
  refeicaoId String
  refeicao   Refeicao       @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  data       DateTime       @db.Date
  status     StatusRefeicao
  comentario String?
  criadoEm   DateTime       @default(now())

  @@unique([alunoId, refeicaoId, data])
  @@index([alunoId, data(sort: Desc)])
}

model MetaAgua {
  id            String   @id @default(cuid())
  alunoId       String   @unique
  aluno         User     @relation("MetaDeAgua", fields: [alunoId], references: [id], onDelete: Cascade)
  metaMlDia     Int
  definidoPorId String?
  /// Janela em que faz sentido lembrar de beber água — ninguém quer alerta às 3h.
  horaInicio    Int      @default(7)
  horaFim       Int      @default(22)
  atualizadoEm  DateTime @updatedAt
}

model RegistroAgua {
  id           String   @id @default(cuid())
  alunoId      String
  aluno        User     @relation("RegistrosDeAgua", fields: [alunoId], references: [id])
  data         DateTime @db.Date
  volumeMl     Int
  registradoEm DateTime @default(now())

  @@index([alunoId, data(sort: Desc)])
  @@index([alunoId, registradoEm(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Prescrições — suplementos, fitoterápicos e orientações
// ---------------------------------------------------------------------------

enum TipoPrescritivel {
  SUPLEMENTO
  FITOTERAPICO
  MEDICAMENTO
  ORIENTACAO
}

enum EscopoPrescritivel {
  GLOBAL
  PRIVADO
}

/// Catálogo do que pode ser prescrito. GLOBAL é curado pelo admin; PRIVADO
/// pertence ao profissional que cadastrou.
model ItemPrescritivel {
  id               String             @id @default(cuid())
  nome             String
  tipo             TipoPrescritivel
  /// Ex.: "cápsula 500 mg", "pote 900 g", "solução 20 mg/mL".
  apresentacao     String?
  principioAtivo   String?
  /// Texto livre — a bula não cabe num enum.
  contraindicacoes String?
  observacao       String?
  escopo           EscopoPrescritivel @default(PRIVADO)
  criadoPorId      String?
  criadoPor        User?              @relation("ItensPrescritiveis", fields: [criadoPorId], references: [id])
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt
  deletadoEm       DateTime?

  itensDeModelo    ItemModeloPrescricao[]
  itensPrescritos  ItemPrescricao[]

  @@index([tipo, escopo])
  @@index([criadoPorId])
}

/// Modelo reutilizável de prescrição, com posologia já definida.
model ModeloPrescricao {
  id           String   @id @default(cuid())
  prescritorId String
  prescritor   User     @relation("ModelosDePrescricao", fields: [prescritorId], references: [id], onDelete: Cascade)
  nome         String
  descricao    String?
  orientacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  deletadoEm   DateTime?

  itens ItemModeloPrescricao[]

  @@index([prescritorId, deletadoEm])
}

model ItemModeloPrescricao {
  id            String           @id @default(cuid())
  modeloId      String
  modelo        ModeloPrescricao @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  prescritivelId String
  prescritivel  ItemPrescritivel @relation(fields: [prescritivelId], references: [id])
  dose          Decimal?         @db.Decimal(8, 2)
  unidade       String?
  frequencia    String?
  horarios      String[]         @default([])
  duracaoDias   Int?
  via           String?
  observacao    String?
  ordem         Int

  @@unique([modeloId, ordem])
  @@index([prescritivelId])
}

enum StatusPrescricao {
  ATIVA
  SUSPENSA
  ENCERRADA
  SUBSTITUIDA
}

/// Prescrição emitida a um paciente.
///
/// É registro clínico: NUNCA é editada no lugar. Mudar a conduta cria uma
/// versão nova e marca a anterior como SUBSTITUIDA — o histórico precisa
/// mostrar o que estava valendo em cada data.
model Prescricao {
  id           String           @id @default(cuid())
  alunoId      String
  aluno        User             @relation("PrescricoesDoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  prescritorId String
  prescritor   User             @relation("PrescricoesEmitidas", fields: [prescritorId], references: [id])
  data         DateTime         @db.Date
  validaAte    DateTime?        @db.Date
  orientacoes  String?
  versao       Int              @default(1)
  raizId       String?
  status       StatusPrescricao @default(ATIVA)
  encerradaEm  DateTime?
  motivoEncerramento String?
  criadoEm     DateTime         @default(now())

  itens ItemPrescricao[]

  @@index([alunoId, status])
  @@index([raizId])
}

model ItemPrescricao {
  id             String           @id @default(cuid())
  prescricaoId   String
  prescricao     Prescricao       @relation(fields: [prescricaoId], references: [id], onDelete: Cascade)
  prescritivelId String
  prescritivel   ItemPrescritivel @relation(fields: [prescritivelId], references: [id])
  /// Congelado no momento da emissão: renomear o item do catálogo depois não
  /// pode alterar o que foi prescrito.
  nomeNoMomento  String
  dose           Decimal?         @db.Decimal(8, 2)
  unidade        String?
  frequencia     String?
  horarios       String[]         @default([])
  duracaoDias    Int?
  via            String?
  observacao     String?
  ordem          Int

  @@unique([prescricaoId, ordem])
  @@index([prescritivelId])
}

// ---------------------------------------------------------------------------
// Avaliação física — adipometria e bioimpedância
// ---------------------------------------------------------------------------

enum MetodoAvaliacao {
  ADIPOMETRIA
  BIOIMPEDANCIA
  MANUAL
}

enum ProtocoloDobras {
  POLLOCK_3
  POLLOCK_7
}

/// Uma avaliação física. Guarda a ENTRADA (dobras ou leitura da balança) junto
/// do resultado: sem isso, uma correção futura de fórmula não teria como
/// recalcular o histórico, e o número antigo viraria dado órfão.
model AvaliacaoFisica {
  id                String           @id @default(cuid())
  alunoId           String
  aluno             User             @relation("AvaliacoesDoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  avaliadorId       String
  avaliador         User             @relation("AvaliacoesFeitas", fields: [avaliadorId], references: [id])
  data              DateTime         @db.Date
  metodo            MetodoAvaliacao
  protocolo         ProtocoloDobras?
  sexo              String?
  idade             Int?
  pesoKg            Decimal          @db.Decimal(5, 2)
  alturaCm          Int?
  /// Dobras em milímetros, por ponto anatômico.
  dobras            Json?
  /// Campos extras da balança (água corporal, massa óssea, TMB, gordura visceral).
  bioimpedancia     Json?
  percentualGordura Decimal          @db.Decimal(4, 1)
  massaGordaKg      Decimal          @db.Decimal(5, 2)
  massaMagraKg      Decimal          @db.Decimal(5, 2)
  densidadeCorporal Decimal?         @db.Decimal(6, 4)
  somaDobrasMm      Decimal?         @db.Decimal(5, 1)
  imc               Decimal?         @db.Decimal(4, 1)
  observacao        String?
  criadoEm          DateTime         @default(now())
  deletadoEm        DateTime?

  @@index([alunoId, data(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Agenda — atendimentos, avaliações e consultorias
// ---------------------------------------------------------------------------

enum TipoCompromisso {
  AVALIACAO_FISICA
  CONSULTA
  RETORNO
  TREINO_ACOMPANHADO
  CONSULTORIA_ONLINE
  OUTRO
}

enum StatusCompromisso {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
  NAO_COMPARECEU
}

/// Um atendimento marcado. Serve os três profissionais: o médico marca consulta,
/// o nutricionista marca avaliação, o personal marca treino acompanhado.
model Compromisso {
  id             String            @id @default(cuid())
  profissionalId String
  profissional   User              @relation("AgendaDoProfissional", fields: [profissionalId], references: [id], onDelete: Cascade)
  alunoId        String
  aluno          User              @relation("CompromissosDoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  tipo           TipoCompromisso
  titulo         String?
  inicioEm       DateTime
  fimEm          DateTime
  /// Presencial (endereço/sala) ou "Online".
  local          String?
  observacao     String?
  status         StatusCompromisso @default(AGENDADO)
  criadoPorId    String
  canceladoEm    DateTime?
  motivoCancelamento String?
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  @@index([profissionalId, inicioEm])
  @@index([alunoId, inicioEm])
  @@index([status])
}

/// Janela semanal em que o profissional atende. Base para sugerir horários livres.
model DisponibilidadeSlot {
  id             String   @id @default(cuid())
  profissionalId String
  profissional   User     @relation("DisponibilidadeDoProfissional", fields: [profissionalId], references: [id], onDelete: Cascade)
  /// 1 = segunda ... 7 = domingo
  diaSemana      Int
  /// "HH:MM" no fuso do profissional
  horaInicio     String
  horaFim        String
  /// Duração padrão de um atendimento nesta janela, em minutos.
  duracaoMin     Int      @default(60)
  criadoEm       DateTime @default(now())

  @@unique([profissionalId, diaSemana, horaInicio])
}

/// Férias, feriado, compromisso pessoal — some da lista de horários livres.
model BloqueioAgenda {
  id             String   @id @default(cuid())
  profissionalId String
  profissional   User     @relation("BloqueiosDoProfissional", fields: [profissionalId], references: [id], onDelete: Cascade)
  inicioEm       DateTime
  fimEm          DateTime
  motivo         String?
  criadoEm       DateTime @default(now())

  @@index([profissionalId, inicioEm])
}

// ---------------------------------------------------------------------------
// 4.7 — Comunicação
// ---------------------------------------------------------------------------

enum TipoConversa {
  /// Aluno e um profissional. Basta o vínculo ativo.
  ALUNO_PROFISSIONAL
  /// Os profissionais entre si, SEM o aluno. Exige consentimento MENSAGENS.
  EQUIPE_CLINICA
}

/// Toda conversa orbita um aluno — é o que permite, na Fase 3, os três
/// profissionais conversarem sobre o mesmo paciente.
model Conversa {
  id           String       @id @default(cuid())
  tipo         TipoConversa
  alunoId      String
  aluno        User         @relation("ConversasDoAluno", fields: [alunoId], references: [id])
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  participantes ParticipanteConversa[]
  mensagens     Mensagem[]

  /// Uma conversa por tipo por aluno-profissional (o par vem do participante).
  @@index([alunoId, tipo])
}

model ParticipanteConversa {
  conversaId String
  conversa   Conversa  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("ParticipacoesEmConversas", fields: [userId], references: [id], onDelete: Cascade)
  entrouEm   DateTime  @default(now())
  saiuEm     DateTime?
  /// Última vez que abriu a conversa — base do contador de não lidas.
  vistoEm    DateTime?

  @@id([conversaId, userId])
  @@index([userId, saiuEm])
}

enum TipoMensagem {
  TEXTO
  ARQUIVO
  SISTEMA
}

model Mensagem {
  id           String       @id @default(cuid())
  conversaId   String
  conversa     Conversa     @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User         @relation("MensagensEnviadas", fields: [autorId], references: [id])
  tipo         TipoMensagem @default(TEXTO)
  corpo        String?
  chaveArquivo String?
  /// Gerado no cliente: torna o envio idempotente, como no treino offline.
  clienteUuid  String       @unique
  enviadaEm    DateTime     @default(now())
  editadaEm    DateTime?
  removidaEm   DateTime?

  @@index([conversaId, enviadaEm(sort: Desc)])
}

// ---------------------------------------------------------------------------
// 4.8 — Notificações e lembretes
// ---------------------------------------------------------------------------

enum TipoLembrete {
  TREINO
  REFEICAO
  AGUA
  CONSULTA
  MENSAGEM
}

model TokenDispositivo {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  plataforma String // IOS | ANDROID | WEB
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())
  usadoEm    DateTime @default(now())

  @@index([userId, ativo])
}

/// Quando e por onde o aluno quer ser lembrado.
model ConfiguracaoLembrete {
  id           String       @id @default(cuid())
  alunoId      String
  aluno        User         @relation("LembretesDoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  tipo         TipoLembrete
  /// Horários locais do aluno, formato "HH:MM".
  horarios     String[]     @default([])
  /// Dias da semana (1=segunda ... 7=domingo). Vazio = todos.
  diasDaSemana Int[]        @default([])
  canais       String[]     @default(["PUSH"])
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@unique([alunoId, tipo])
}

/// Notificação gerada. Guardar antes de enviar dá histórico e evita duplicata.
model Notificacao {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation("NotificacoesDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  tipo         TipoLembrete
  titulo       String
  corpo        String
  deeplink     String?
  /// Data local (do aluno) a que este lembrete se refere — base da deduplicação.
  referenteA   DateTime     @db.Date
  agendadaPara DateTime
  enviadaEm    DateTime?
  falhaEm      DateTime?
  erro         String?
  lidaEm       DateTime?
  criadoEm     DateTime     @default(now())

  /// Um lembrete de cada tipo por dia, por usuário.
  @@unique([userId, tipo, referenteA])
  @@index([userId, criadoEm(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Auth — sessões de refresh (suporte ao B2)
// ---------------------------------------------------------------------------

/// Refresh token rotativo com detecção de reuso.
///
/// Cada login abre uma "família". Cada refresh emite um token novo e marca o
/// anterior como usado. Se um token JÁ USADO for reapresentado, significa que
/// vazou: revogamos a família inteira e forçamos novo login.
/// Preparação com ingredientes e modo de preparo. Os macros saem da soma dos
/// ingredientes dividida pelo rendimento — nunca digitados à mão.
model Receita {
  id            String  @id @default(cuid())
  autorId       String
  autor         User    @relation("ReceitasDoAutor", fields: [autorId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  modoPreparo   String?
  /// Quantas porções a receita inteira rende.
  rendePorcoes  Decimal @default(1) @db.Decimal(6, 2)
  /// Nome da porção como o aluno entende: "1 fatia", "1 concha".
  nomeDaPorcao  String?
  tempoMinutos  Int?
  deletadoEm    DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  ingredientes IngredienteReceita[]
  itensDeRefeicao ItemRefeicaoSalva[]

  @@index([autorId, deletadoEm])
}

model IngredienteReceita {
  id          String   @id @default(cuid())
  receitaId   String
  receita     Receita  @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  alimentoId  String
  alimento    Alimento @relation("IngredientesDeReceita", fields: [alimentoId], references: [id])
  quantidadeG Decimal  @db.Decimal(7, 2)
  observacao  String?
  ordem       Int

  @@index([receitaId, ordem])
}

/// Refeição avulsa reutilizável — "Café da manhã 400 kcal" que serve em vários
/// cardápios. Diferente de `RefeicaoModelo`, que só existe dentro de um cardápio.
model RefeicaoSalva {
  id              String   @id @default(cuid())
  autorId         String
  autor           User     @relation("RefeicoesDoAutor", fields: [autorId], references: [id], onDelete: Cascade)
  nome            String
  horarioSugerido String?
  observacao      String?
  deletadoEm      DateTime?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  itens ItemRefeicaoSalva[]

  @@index([autorId, deletadoEm])
}

/// Item de refeição salva: ou um alimento com gramas, ou uma receita com
/// porções. Um dos dois, nunca os dois — garantido no serviço.
model ItemRefeicaoSalva {
  id          String        @id @default(cuid())
  refeicaoId  String
  refeicao    RefeicaoSalva @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)
  alimentoId  String?
  alimento    Alimento?     @relation("ItensDeRefeicaoSalva", fields: [alimentoId], references: [id])
  receitaId   String?
  receita     Receita?      @relation(fields: [receitaId], references: [id])
  quantidadeG Decimal?      @db.Decimal(7, 2)
  porcoes     Decimal?      @db.Decimal(6, 2)
  observacao  String?
  ordem       Int

  @@index([refeicaoId, ordem])
}

enum TipoPergunta {
  TEXTO
  TEXTO_LONGO
  SIM_NAO
  ESCOLHA_UNICA
  ESCOLHA_MULTIPLA
  NUMERO
  DATA
}

/// Questionário que o profissional monta uma vez e aplica a vários pacientes.
model ModeloAnamnese {
  id            String            @id @default(cuid())
  profissionalId String
  profissional  User              @relation("ModelosDeAnamnese", fields: [profissionalId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  perguntas     PerguntaAnamnese[]
  anamneses     Anamnese[]
  deletadoEm    DateTime?
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  @@index([profissionalId, deletadoEm])
}

model PerguntaAnamnese {
  id         String         @id @default(cuid())
  modeloId   String
  modelo     ModeloAnamnese @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  texto      String
  tipo       TipoPergunta
  /// Só para ESCOLHA_UNICA e ESCOLHA_MULTIPLA.
  opcoes     String[]       @default([])
  obrigatoria Boolean       @default(false)
  /// Texto de apoio abaixo da pergunta ("liste também os suplementos").
  ajuda      String?
  ordem      Int
  respostas  RespostaAnamnese[]

  @@index([modeloId, ordem])
}

/// Anamnese aplicada a um paciente. Dado de saúde: escopo CLINICO.
model Anamnese {
  id             String    @id @default(cuid())
  alunoId        String
  aluno          User      @relation("AnamnesesDoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   User      @relation("AnamnesesAplicadas", fields: [profissionalId], references: [id], onDelete: Cascade)
  modeloId       String?
  modelo         ModeloAnamnese? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  /// Congelado na aplicação: renomear o modelo depois não muda o histórico.
  nomeNoMomento  String
  observacao     String?
  respondidaEm   DateTime  @default(now())
  respostas      RespostaAnamnese[]
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@index([alunoId, respondidaEm])
}

model RespostaAnamnese {
  id            String            @id @default(cuid())
  anamneseId    String
  anamnese      Anamnese          @relation(fields: [anamneseId], references: [id], onDelete: Cascade)
  perguntaId    String?
  pergunta      PerguntaAnamnese? @relation(fields: [perguntaId], references: [id], onDelete: SetNull)
  /// Pergunta e tipo congelados: editar o modelo não pode reescrever o que a
  /// pessoa respondeu, nem mudar como a resposta deve ser lida.
  perguntaNoMomento String
  tipoNoMomento  TipoPergunta
  /// Resposta em texto. Múltipla escolha usa `valores`.
  valor          String?
  valores        String[]          @default([])
  ordem          Int

  @@index([anamneseId, ordem])
}

/// Token de confirmação de e-mail. Mesmo tratamento do refresh: só o hash é
/// persistido, então vazar o banco não permite confirmar e-mail de ninguém.
model TokenVerificacaoEmail {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// O e-mail alvo fica registrado: se a pessoa trocar de e-mail antes de
  /// confirmar, o token antigo não vale para o endereço novo.
  email     String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([userId, usadoEm])
}

model SessaoRefresh {
  id         String    @id @default(cuid())
  familiaId  String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Guardamos só o hash — token em claro nunca toca o banco
  tokenHash  String    @unique
  expiraEm   DateTime
  usadoEm    DateTime?
  revogadoEm DateTime?
  ip         String?
  userAgent  String?
  criadoEm   DateTime  @default(now())

  @@index([userId, revogadoEm])
  @@index([familiaId])
}
