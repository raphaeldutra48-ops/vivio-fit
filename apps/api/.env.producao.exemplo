# Variáveis do serviço `api` no Railway — domínio viviofit.com.br
#
# Este arquivo é modelo versionado. NÃO preencher os segredos aqui: os valores
# reais vão direto no painel do Railway, nunca em arquivo do repositório e nunca
# pelo chat.

NODE_ENV=production

# --- banco (Neon) -----------------------------------------------------------
# DATABASE_URL: a string COM "-pooler" no host — é a que a aplicação usa.
# DIRECT_URL:   a string SEM "-pooler" — o Prisma migrate precisa de conexão
#               direta, o pooler não suporta os comandos de migração.
DATABASE_URL=
DIRECT_URL=

# --- sessão -----------------------------------------------------------------
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Não reaproveitar os de desenvolvimento: eles já circularam nesta máquina.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 'lax' porque api. e app. são subdomínios do mesmo domínio (same-site).
COOKIE_SAMESITE=lax

# Quantos proxies existem entre o cliente e a API. No Railway é 1 (o roteador
# de borda). Sem isto, `req.ip` é o IP do proxy — o mesmo para todo mundo — e o
# limite de tentativas de login por IP trancaria o login geral em vez do
# atacante. Não aumentar sem necessidade: cada salto a mais é um trecho do
# X-Forwarded-For que passa a ser aceito, e quem manda o cabeçalho na mão
# escolheria o próprio IP.
PROXY_HOPS=1

# --- endereços --------------------------------------------------------------
# Sem ORIGENS_PERMITIDAS a API não sobe — proposital.
ORIGENS_PERMITIDAS=https://app.viviofit.com.br
WEB_PUBLIC_URL=https://app.viviofit.com.br
API_PUBLIC_URL=https://api.viviofit.com.br

# --- e-mail -----------------------------------------------------------------
# Sem SMTP_URL o link de confirmação só vai para o log e ninguém consegue
# entrar. Formato: smtp://usuario:senha@smtp.provedor.com:587
SMTP_URL=
EMAIL_REMETENTE=Vívio Fit <nao-responda@viviofit.com.br>

# --- agendamento ------------------------------------------------------------
LEMBRETES_ATIVOS=true

# --- mídia ------------------------------------------------------------------
# Driver local grava no disco do contêiner, que o Railway descarta a cada
# deploy: as fotos de evolução somem. Trocar por S3/R2 antes de ter usuário de
# verdade (pendência 19).
MEDIA_DIR=./media
