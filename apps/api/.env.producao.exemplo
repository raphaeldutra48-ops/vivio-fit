# Variáveis do serviço `api` no Railway — domínio viviofit.com.br
#
# Este arquivo é modelo versionado. NÃO preencher os segredos aqui: os valores
# reais vão direto no painel do Railway, nunca em arquivo do repositório e nunca
# pelo chat.

NODE_ENV=production

# --- banco (Neon) -----------------------------------------------------------
# DATABASE_URL: a string COM "-pooler" no host — é a que a aplicação usa.
# DIRECT_URL:   a string SEM "-pooler" — o Prisma migrate precisa de conexão
#               direta, o pooler não suporta os comandos de migração.
DATABASE_URL=
DIRECT_URL=

# --- sessão -----------------------------------------------------------------
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Não reaproveitar os de desenvolvimento: eles já circularam nesta máquina.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 'lax' porque api. e app. são subdomínios do mesmo domínio (same-site).
COOKIE_SAMESITE=lax

# Quantos proxies existem entre o cliente e a API. No Railway é 1 (o roteador
# de borda). Sem isto, `req.ip` é o IP do proxy — o mesmo para todo mundo — e o
# limite de tentativas de login por IP trancaria o login geral em vez do
# atacante. Não aumentar sem necessidade: cada salto a mais é um trecho do
# X-Forwarded-For que passa a ser aceito, e quem manda o cabeçalho na mão
# escolheria o próprio IP.
PROXY_HOPS=1

# --- endereços --------------------------------------------------------------
# Sem ORIGENS_PERMITIDAS a API não sobe — proposital.
ORIGENS_PERMITIDAS=https://app.viviofit.com.br
WEB_PUBLIC_URL=https://app.viviofit.com.br
API_PUBLIC_URL=https://api.viviofit.com.br

# --- e-mail -----------------------------------------------------------------
# Sem uma destas duas o link de confirmação só vai para o log e ninguém
# consegue ativar a conta. Em produção a API se RECUSA a subir assim — ver
# src/entrega-de-email.ts.
#
# Com Resend, basta a chave: o código monta
# `smtp://resend:CHAVE@smtp.resend.com:587` sozinho (`urlDoSmtp`). Montar essa
# URL na mão dentro de um campo de painel é pedir para errar, e o erro sai como
# "não conecta", indistinguível de chave errada.
RESEND_API_KEY=

# Só para OUTRO provedor. Quando as duas existem, esta ganha.
# SMTP_URL=smtp://usuario:senha@smtp.provedor.com:587

# O domínio daqui precisa estar verificado no provedor, senão a mensagem é
# recusada no envio.
EMAIL_REMETENTE=Vívio Fit <nao-responda@viviofit.com.br>

# Escapatória para o intervalo entre subir a API e contratar o provedor: deixa
# a API subir sabendo que ninguém consegue se cadastrar. Apague quando houver
# entrega — é ela que mantém a falha visível.
# EMAIL_SEM_ENTREGA=true

# Confere a configuração sem sujar a base com cadastro de teste:
#   EMAIL_TESTE_PARA=voce@exemplo.com pnpm --filter @vivio/api email-teste

# --- agendamento ------------------------------------------------------------
LEMBRETES_ATIVOS=true

# --- mídia ------------------------------------------------------------------
# Driver local grava no disco do contêiner, que o Railway descarta a cada
# deploy: as fotos de evolução somem. Trocar por S3/R2 antes de ter usuário de
# verdade (pendência 19).
MEDIA_DIR=./media

# --- instalação (temporárias — usar uma vez e APAGAR) -----------------------
# O banco de produção nasce vazio. Estas duas variáveis existem só para a
# primeira subida: com elas definidas, o contêiner cria o administrador no
# start e escreve no log. Depois disso, apague as duas — senha em texto claro
# no painel é senha exposta a todo mundo que tem acesso ao projeto.
#
# A senha do admin exige 12 caracteres (o cadastro comum pede 8): é a conta que
# libera quem acessa dado de saúde de terceiros, e não há ninguém acima dela.
# ADMIN_EMAIL=voce@viviofit.com.br
# ADMIN_SENHA=
# ADMIN_NOME=Raphael

# Popula exercícios globais e a tabela de alimentos. Sem isto o app sobe
# funcionando e inútil: nenhum exercício para montar treino, nenhum alimento
# para montar dieta. Rodar uma vez e remover.
# SEMEAR_CATALOGO=true
