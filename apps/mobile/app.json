{
  "expo": {
    "name": "Vívio Fit",
    "slug": "vivio-fit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "viviofit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA",
      "dark": {
        "backgroundColor": "#0E1216"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.viviofit.app"
    },
    "android": {
      "package": "br.com.viviofit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F9D6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "owner": "vivio-fit",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e7cd601-fdc8-46fe-bac5-c5d49e10eb1b"
    },
    "extra": {
      "apiUrl": "https://api.viviofit.com.br",
      "router": {},
      "eas": {
        "projectId": "0e7cd601-fdc8-46fe-bac5-c5d49e10eb1b"
      }
    }
  }
}
